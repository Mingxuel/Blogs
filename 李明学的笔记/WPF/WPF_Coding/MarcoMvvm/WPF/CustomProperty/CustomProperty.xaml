<UserControl x:Class="MarcoMVVM.CustomProperty"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MarcoMVVM"
             mc:Ignorable="d" 
             Width="450" Height="200" BorderThickness="1" BorderBrush="Black">
    <UserControl.DataContext>
        <local:CustomPropertyViewModel />
    </UserControl.DataContext>
    <Grid>
        <TextBlock Foreground="White" Text="{Binding CustomText}"/>
    </Grid>
</UserControl>
