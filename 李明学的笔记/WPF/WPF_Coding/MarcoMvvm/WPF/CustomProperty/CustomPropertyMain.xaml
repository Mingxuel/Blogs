<UserControl x:Class="MarcoMVVM.CustomPropertyMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MarcoMVVM"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <local:CustomProperty Grid.Row="0" CustomText="{Binding Text}" Foreground="White"/>
        <Button Grid.Row="1" Command="{Binding ClickCommand}" Content="Hello World"/>
        
    </Grid>
</UserControl>
