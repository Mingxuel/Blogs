                <TextBox x:Name="tb_1_1" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Grid.RowSpan="2" Grid.Column="3" Header="2S GO" FontSize="45" FontWeight="Bold" Foreground="White" Margin="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="lb_1_2" Grid.Row="0" Grid.Column="0" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
                <Button x:Name="bt_1_2" Grid.Row="1" Grid.Column="0" Margin="3" Click="bt_1_2_Click" Content="GENERATE" FontSize="24"/>
                <TextBox x:Name="tb_1_2" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
        