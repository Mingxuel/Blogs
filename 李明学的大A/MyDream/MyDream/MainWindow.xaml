<Window x:Class="MyDream.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyDream"
        mc:Ignorable="d"
        Title="MainWindow" Background="Black" FontFamily="Verdana" MinWidth="960" WindowStartupLocation="CenterScreen" MinHeight="960">
    <Grid>
        <TabControl>
            <TabItem Header="DATA" Background="Black" Foreground="#FF8000" FontSize="16" FontWeight="Bold" Width="100" Height="30">
                <Grid>
                    <local:Board Margin="0"/>
                </Grid>
            </TabItem>
            <TabItem Header="LEVEL-2" Background="Black" Foreground="#FF8000" FontSize="16" FontWeight="Bold" Width="100" Height="30">
                <Grid>
                    <local:Level2 Margin="0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
        