<Window x:Class="MyDream.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyDream"
        mc:Ignorable="d"
        Title="MainWindow" Background="Black" MinWidth="1920" MinHeight="1080">
    <Grid>
        <TabControl>
            <TabItem Header="DATA" Background="Black" Foreground="#FF8000">
                <Grid>
                    <local:DataAnalyze Margin="0"/>
                </Grid>
            </TabItem>
            <TabItem Header="LEVEL-2" Background="Black" Foreground="#FF8000">
                <Grid>
                    <local:Level2 Margin="0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
        