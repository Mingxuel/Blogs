<Window x:Class="MyDream.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyDream"
        mc:Ignorable="d"
        Title="MainWindow" Background="Black" Width="960" Height="720" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="DAYS" VerticalAlignment="Center" FontSize="45" FontWeight="Bold" Foreground="White"/>
        <TextBox x:Name="tb_days" Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Background="Black" Foreground="White" TextWrapping="WrapWithOverflow" Margin="3" IsReadOnly="False" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" AcceptsReturn="True" Width="122"/>
        <Button Grid.Row="3" Grid.Column="0" Margin="3" Content="LOAD" FontWeight="Bold" FontSize="24" Click="LoadClick"/>
        <GroupBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Header="2F" FontSize="45" FontWeight="Bold" Foreground="White" Margin="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="lb_0_0" Grid.Row="0" Grid.Column="0" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
                <Button x:Name="bt_0_0" Grid.Row="1" Grid.Column="0" Margin="3" Click="bt_0_0_Click" Content="GENERATE" FontSize="24"/>
                <TextBox x:Name="tb_0_0" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Header="2F GO" FontSize="45" FontWeight="Bold" Foreground="White" Margin="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="lb_0_1" Grid.Row="0" Grid.Column="0" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
                <Button x:Name="bt_0_1" Grid.Row="1" Grid.Column="0" Margin="3" Click="bt_0_1_Click" Content="GENERATE" FontSize="24"/>
                <TextBox x:Name="tb_0_1" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Header="2F GO" FontSize="45" FontWeight="Bold" Foreground="White" Margin="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="lb_0_2" Grid.Row="0" Grid.Column="0" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
                <Button x:Name="bt_0_2" Grid.Row="1" Grid.Column="0" Margin="3" Click="bt_0_2_Click" Content="GENERATE" FontSize="24"/>
                <TextBox x:Name="tb_0_2" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Header="2S" FontSize="45" FontWeight="Bold" Foreground="White" Margin="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="lb_1_0" Grid.Row="0" Grid.Column="0" Margin="3" Background="Black" Foreground="White" FontSize="20"/>
